# lsp.yaml.example — 网关配置样例（audit #5）
#
# 使用方式：
#   cp lsp.yaml.example lsp.yaml && 按需填写
# 红线：
#   lsp.yaml 已在 .gitignore（可含明文凭证），永不提交；
#   推荐 env 注入凭证（FEISHU_APP_ID / FEISHU_APP_SECRET），文件只留绑定面。

feishu:
  # app_id: cli_xxx
  # app_secret: <推荐留空走 env FEISHU_APP_SECRET>
  domain: feishu            # feishu | lark
  # ── feishu-callback 绑定（01-protocol §3.2，卡片交互回程）────────
  # 未配置 verification_token → 回调端点恒 503（fail-closed 可见禁用态）；
  # encrypt_key 可选：配置后接受 {"encrypt": ...} 密文回调（AES-256-CBC）。
  # 推荐 env 注入：FEISHU_VERIFICATION_TOKEN / FEISHU_ENCRYPT_KEY
  # verification_token: <飞书开放平台「事件订阅」页的 Verification Token>
  # encrypt_key: <同页 Encrypt Key（启用加密时才需要）>

gateway:
  bind: stdio               # stdio | http | ws（逗号多值）
  host: "127.0.0.1"         # 非 loopback 监听必须配 auth_token（fail-closed）
  port: 7800
  # auth_token: <HTTP/WS Bearer 鉴权；推荐走 env LSP_GATEWAY_TOKEN>

settings:
  watchdog_idle_sec: 300
  panel_flush_sec: 0.2
  clarify_window_sec: 1.2
  card_ttl_sec: 600
  pending_max: 64

theme:
  reasoning_level: full     # full | brief | hidden
  # tool_icons:
  #   grep: "🔍"
